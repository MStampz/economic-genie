# Copy to .env to change these. The defaults are fine for one Mac.

# Database password (only used inside Docker; the database is never exposed outside it).
GENIE_DB_PASSWORD=genie-local-only

# 127.0.0.1 = only this Mac. 0.0.0.0 = also phones and laptops on your home Wi-Fi.
GENIE_BIND=127.0.0.1
GENIE_PORT=3000
